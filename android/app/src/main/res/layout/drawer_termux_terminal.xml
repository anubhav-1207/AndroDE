<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rightDrawerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_background"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#121215"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TERMUX IPC STREAM"
            android:textColor="@color/gutter_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/btnClearOutput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:textColor="#A1A1AA"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:paddingEnd="10dp" />

        <TextView
            android:id="@+id/tvTermuxStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Ready"
            android:textColor="@color/accent_emerald"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/panel_border" />

    <!-- Terminal Command Execution Log & Stdout/Stderr -->
    <ScrollView
        android:id="@+id/scrollTerminal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0A0C"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvTerminalOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[TermuxBridge] IPC initialized via com.termux.RUN_COMMAND\n$ ~ "
            android:textColor="#22C55E"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Terminal Prompt Input for custom commands -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="#121215"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="termux$ "
            android:textColor="@color/accent_emerald"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTerminalInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Execute command in Termux..."
            android:textColor="@color/editor_text"
            android:textColorHint="#52525B"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:imeOptions="actionSend"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btnSendTerminalCmd"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_send" />
    </LinearLayout>
</LinearLayout>
