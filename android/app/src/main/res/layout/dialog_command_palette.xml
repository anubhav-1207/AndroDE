<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/panel_background"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Fuzzy search input with Ctrl+P label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#0E0E11"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="> "
            android:textColor="@color/accent_blue"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPaletteSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Type a command or file name (e.g. 'run', 'theme', 'save')..."
            android:textColor="@color/editor_text"
            android:textColorHint="#52525B"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/panel_border"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <!-- Command List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPaletteResults"
        android:layout_width="match_parent"
        android:layout_height="220dp" />
</LinearLayout>
