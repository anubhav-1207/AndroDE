<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/leftDrawerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_background"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#121215"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EXPLORER"
            android:textColor="@color/gutter_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/btnNewFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ New File"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/panel_border" />

    <!-- Project File List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFileTree"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="6dp" />

    <!-- Drawer Footer: Quick Tips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#121215">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHORTCUTS"
            android:textColor="@color/gutter_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ctrl+S: Save file\nCtrl+P: Command palette\nCtrl+T: Termux console\nCtrl+E: Toggle explorer"
            android:textColor="#A1A1AA"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</LinearLayout>
